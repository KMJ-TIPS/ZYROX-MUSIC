<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">

            <group
                android:scaleX="0.62"
                android:scaleY="0.62"
                android:pivotX="54"
                android:pivotY="54"
                android:translateX="-3">

                <!-- The Z glyph: scales + fades in -->
                <group
                    android:name="zyrox_z"
                    android:alpha="0"
                    android:scaleX="0.7"
                    android:scaleY="0.7"
                    android:pivotX="46"
                    android:pivotY="53">
                    <path
                        android:pathData="M28,37 L64,37 L64,45.5 L42.5,60.5 L64,60.5 L64,69 L28,69 L28,60.5 L49.5,45.5 L28,45.5 Z">
                        <aapt:attr name="android:fillColor">
                            <gradient
                                android:type="linear"
                                android:startX="28" android:startY="37"
                                android:endX="64" android:endY="69">
                                <item android:offset="0.0" android:color="#FFFFE08A" />
                                <item android:offset="0.55" android:color="#FFFFC24B" />
                                <item android:offset="1.0" android:color="#FFFFA114" />
                            </gradient>
                        </aapt:attr>
                    </path>
                </group>

                <!-- Equalizer bars: pop up in sequence -->
                <group
                    android:name="zyrox_bar1"
                    android:scaleY="0.08"
                    android:pivotX="72.3"
                    android:pivotY="69">
                    <path android:pathData="M70,54 h4.6 v15 h-4.6 z">
                        <aapt:attr name="android:fillColor">
                            <gradient
                                android:type="linear"
                                android:startX="70" android:startY="54"
                                android:endX="70" android:endY="69">
                                <item android:offset="0.0" android:color="#FFFFFFFF" />
                                <item android:offset="1.0" android:color="#FFD9C8FF" />
                            </gradient>
                        </aapt:attr>
                    </path>
                </group>

                <group
                    android:name="zyrox_bar2"
                    android:scaleY="0.08"
                    android:pivotX="80"
                    android:pivotY="69">
                    <path android:pathData="M77.7,45 h4.6 v24 h-4.6 z">
                        <aapt:attr name="android:fillColor">
                            <gradient
                                android:type="linear"
                                android:startX="77.7" android:startY="45"
                                android:endX="77.7" android:endY="69">
                                <item android:offset="0.0" android:color="#FFFFFFFF" />
                                <item android:offset="1.0" android:color="#FFD9C8FF" />
                            </gradient>
                        </aapt:attr>
                    </path>
                </group>

                <group
                    android:name="zyrox_bar3"
                    android:scaleY="0.08"
                    android:pivotX="87.7"
                    android:pivotY="69">
                    <path android:pathData="M85.4,50 h4.6 v19 h-4.6 z">
                        <aapt:attr name="android:fillColor">
                            <gradient
                                android:type="linear"
                                android:startX="85.4" android:startY="50"
                                android:endX="85.4" android:endY="69">
                                <item android:offset="0.0" android:color="#FFFFFFFF" />
                                <item android:offset="1.0" android:color="#FFD9C8FF" />
                            </gradient>
                        </aapt:attr>
                    </path>
                </group>
            </group>
        </vector>
    </aapt:attr>

    <!-- Z entrance -->
    <target android:name="zyrox_z">
        <objectAnimator
            android:propertyName="alpha"
            android:duration="280"
            android:valueFrom="0"
            android:valueTo="1"
            android:valueType="floatType"
            android:interpolator="@android:interpolator/decelerate_quad" />
    </target>
    <target android:name="zyrox_z">
        <objectAnimator
            android:propertyName="scaleX"
            android:startOffset="40"
            android:duration="420"
            android:valueFrom="0.7"
            android:valueTo="1"
            android:valueType="floatType"
            android:interpolator="@android:interpolator/decelerate_quad" />
    </target>
    <target android:name="zyrox_z">
        <objectAnimator
            android:propertyName="scaleY"
            android:startOffset="40"
            android:duration="420"
            android:valueFrom="0.7"
            android:valueTo="1"
            android:valueType="floatType"
            android:interpolator="@android:interpolator/decelerate_quad" />
    </target>

    <!-- Bars pop in sequence -->
    <target android:name="zyrox_bar1">
        <objectAnimator
            android:propertyName="scaleY"
            android:startOffset="260"
            android:duration="260"
            android:valueFrom="0.08"
            android:valueTo="1"
            android:valueType="floatType"
            android:interpolator="@android:interpolator/decelerate_quad" />
    </target>
    <target android:name="zyrox_bar2">
        <objectAnimator
            android:propertyName="scaleY"
            android:startOffset="380"
            android:duration="260"
            android:valueFrom="0.08"
            android:valueTo="1"
            android:valueType="floatType"
            android:interpolator="@android:interpolator/decelerate_quad" />
    </target>
    <target android:name="zyrox_bar3">
        <objectAnimator
            android:propertyName="scaleY"
            android:startOffset="500"
            android:duration="260"
            android:valueFrom="0.08"
            android:valueTo="1"
            android:valueType="floatType"
            android:interpolator="@android:interpolator/decelerate_quad" />
    </target>
</animated-vector>
